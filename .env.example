# URL del backend de la app interna
VITE_NICOLE_API=http://localhost:8101/api

# Backend público de la tienda web: de aquí sale la regla de fechas de entrega
# (GET /api/settings/public → minLeadDays, timeSlots). Sin esta variable se usa
# la regla por defecto: desde mañana, de 11h00 a 18h00.
VITE_TIENDA_API=http://localhost:8200/api

# Dominio público de la tienda: arma el link del cliente (/pedido/<token>) en el
# detalle del pedido cuando el backend no lo devuelve.
VITE_TIENDA_URL=https://nicole.com.ec
